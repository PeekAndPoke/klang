    a3 [label="SuperSquareIgnitor\nPolyBLEP, flat gain", fillcolor="#F6E4E2", color="#B23A32"]; a4 [label="SuperTriIgnitor\ninline triangle formula,\nflat gain", fillcolor="#F6E4E2", color="#B23A32"];
